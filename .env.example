# ============================================================
# DEVFORGE AI - ENVIRONMENT CONFIGURATION
# ============================================================

# PORT & HOST CONFIGURATION
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000/api

# DATABASE CONFIGURATION
# MongoDB Connection String (Local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/devforge-ai

# AUTHENTICATION (CLERK)
# Get your keys at https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_sample_clerk_secret_key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_publishable_key

# AI ENGINE (GOOGLE GEMINI)
# Get your key at https://aistudio.google.com
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# GITHUB OAUTH & INTEGRATION
# Personal Access Token or OAuth Client Credentials
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# OPTIONAL INTEGRATIONS
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
